<div class="thought-organizer">
  <h1 class="page-title"><%= @post.new_record? ? "思考整理ノート" : "思考整理ノートの編集" %></h1>

  <%= form_with(model: @post, local: true, class: "thought-form") do |f| %>
    <% if @post.errors.any? %>
      <div class="error-messages">
        <h2><%= @post.errors.count %>件のエラーが発生しました:</h2>
        <ul>
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- ドロワー開閉用アクションバー -->
    <div class="drawer-controls">
      <button type="button" class="btn-drawer btn-emotion" onclick="toggleDrawer('left')">
        <span class="icon">🫗</span>
        <span>左パネル：感情を吐き出す</span>
        <span id="emotion-badge" class="badge">未入力</span>
      </button>

      <button type="button" class="btn-drawer btn-issue" onclick="toggleDrawer('right')">
        <span>右パネル：課題を整理する</span>
        <span class="icon">🤔</span>
        <span id="issue-badge" class="badge">未入力</span>
      </button>
    </div>

    <!-- メインパネル：中央【出来事（客観的事実）】 -->
    <div class="center-panel">
      <div class="panel-header">
        <h2>📌 出来事</h2>
        <p>何があったか教えてください。</p>
      </div>

      <div class="form-group">
        <%= f.text_area :event, rows: 6, placeholder: "例：ミーティングで自身の提案に対して厳しいフィードバックを受けた。", class: "form-control main-textarea" %>
      </div>

      <div class="form-actions">
        <%= f.submit @post.new_record? ? "整理完了して投稿する" : "更新する", class: "btn-submit" %>
      </div>
    </div>

    <!-- 左スライドドロワー【感情（吐き出し）】 -->
    <div id="drawer-left" class="drawer drawer-left">
      <div class="drawer-header">
        <h3>🫗 感情の吐き出し</h3>
        <button type="button" class="btn-close" onclick="toggleDrawer('left')">✕</button>
      </div>
      <p class="drawer-desc">イライラやモヤモヤ、素直な感情をありのままに吐き出してください（振り返り画面では非表示になります）。</p>
      <div class="form-group">
        <%= f.text_area :emotion, id: "post_emotion", rows: 12, placeholder: "例：すごく悲しかったし焦った！言い方がきつくて嫌な気持ちになった。", class: "form-control" %>
      </div>
      <button type="button" class="btn-done" onclick="toggleDrawer('left')">保存して閉じる</button>
    </div>

    <!-- 右スライドドロワー【課題（解決策）】 -->
    <div id="drawer-right" class="drawer drawer-right">
      <div class="drawer-header">
        <h3>🤔 課題の整理</h3>
        <button type="button" class="btn-close" onclick="toggleDrawer('right')">✕</button>
      </div>
      <p class="drawer-desc">感情と切り離し、「自分にできること・今後試せる解決策」を整理します。</p>
      <div class="form-group">
        <%= f.text_area :issue, id: "post_issue", rows: 12, placeholder: "例：相手の言い方の圧が強かったが省みる点もあった", class: "form-control" %>
      </div>
      <button type="button" class="btn-done" onclick="toggleDrawer('right')">保存して閉じる</button>
    </div>

    <!-- 背景暗転用オーバーレイ -->
    <div id="drawer-overlay" class="drawer-overlay" onclick="closeAllDrawers()"></div>
  <% end %>
</div>

<div class="back-link" style="margin-top: 20px; text-align: center;">
  <%= link_to "トップに戻る", root_path %> |
  <%= link_to "一覧へ移動", posts_path %> |
  <%= link_to "投稿せずに戻る", root_path, style: "color: #e03131;" %>
</div>

<!-- ドロワー制御用JS -->
<script>
  function toggleDrawer(direction) {
    const left = document.getElementById('drawer-left');
    const right = document.getElementById('drawer-right');
    const overlay = document.getElementById('drawer-overlay');

    if (!left || !right || !overlay) return;

    if (direction === 'left') {
      left.classList.toggle('active');
      right.classList.remove('active');
    } else if (direction === 'right') {
      right.classList.toggle('active');
      left.classList.remove('active');
    }

    const isActive = left.classList.contains('active') || right.classList.contains('active');
    overlay.classList.toggle('active', isActive);
  }

  function closeAllDrawers() {
    const left = document.getElementById('drawer-left');
    const right = document.getElementById('drawer-right');
    const overlay = document.getElementById('drawer-overlay');

    if (left) left.classList.remove('active');
    if (right) right.classList.remove('active');
    if (overlay) overlay.classList.remove('active');
  }

  // バッジ更新と初期状態チェック
  function setupBadges() {
    const emotionInput = document.getElementById('post_emotion');
    const issueInput = document.getElementById('post_issue');
    const emotionBadge = document.getElementById('emotion-badge');
    const issueBadge = document.getElementById('issue-badge');

    const updateState = (input, badge) => {
      if (!input || !badge) return;
      const hasText = input.value.trim().length > 0;
      badge.textContent = hasText ? '入力あり' : '未入力';
      badge.classList.toggle('filled', hasText);
    };

    if (emotionInput && emotionBadge) {
      updateState(emotionInput, emotionBadge); // 画面表示時の初期チェック
      emotionInput.addEventListener('input', () => updateState(emotionInput, emotionBadge));
    }

    if (issueInput && issueBadge) {
      updateState(issueInput, issueBadge); // 画面表示時の初期チェック
      issueInput.addEventListener('input', () => updateState(issueInput, issueBadge));
    }
  }

  document.addEventListener('turbo:load', setupBadges);
  document.addEventListener('DOMContentLoaded', setupBadges);
</script>
<div class="posts-container">
  <div class="posts-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 class="page-title" style="margin: 0; white-space: nowrap;">投稿一覧</h1>
    <%= link_to "新規投稿作成", new_post_path, class: "btn-custom btn-primary-custom", style: "display: inline-block; width: auto; flex-shrink: 0; padding: 10px 20px; font-size: 0.9rem; text-decoration: none;" %>
  </div>

  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <div class="post-card">
        <div class="post-card-section">
          <h3>📌 出来事</h3>
          <p class="post-card-text"><%= post.event %></p>
        </div>

        <div class="post-card-section">
          <h3>🤔 課題</h3>
          <p class="post-card-text"><%= post.issue %></p>
        </div>

        <div class="post-meta">
          <span>投稿日時: <%= l post.created_at, format: :short %></span>
          
          <div class="action-buttons">
            <%= link_to "詳細を見る", post_path(post), class: "btn-sm btn-outline-primary" %>
            <%= button_to "削除", post_path(post), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn-sm btn-outline-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="post-card" style="text-align: center; color: #718096; padding: 40px 20px;">
      <p>まだ投稿がありません。「新規投稿作成」から思考を書き出してみましょう。</p>
    </div>
  <% end %>

  <div class="back-link">
    <%= link_to "トップに戻る", root_path %>
  </div>
</div>